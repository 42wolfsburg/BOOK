# ============================
# Database
# ============================
POSTGRES_USER={your_postgres_user}
POSTGRES_PASSWORD={your_postgres_password}
POSTGRES_DB={your_db_name}
POSTGRES_HOST={your_db_host}
POSTGRES_PORT={your_db_port}
DATABASE_URL=postgres://{your_postgres_user}:{your_postgres_password}@{your_db_host}:{your_db_port}/{your_db_name}

# ============================
# Backend
# ============================
BACKEND_PORT={your_backend_port_of_choice}
BACKEND_HOST={your_backend_host_of_choice}

# ============================
# 42 OAuth — backend-only
# ============================
CLIENT_ID={your_42_application_uid}
SECRET={your_42_application_secret}
REDIRECT_URI={your_backend_callback_url}
JWT_SECRET={a_long_random_string_used_to_sign_your_own_session_tokens}

# ============================
# Frontend
# ============================
VITE_API_URL={base_url_the_frontend_uses_to_call_the_backend}

# ============================
# Google
# ============================
GOOGLE_WEBAPP_URL_PISCINE={google_webhook_from_cloud_console}
GOOGLE_WEBAPP_URL_GALAXY={google_webhook_from_cloud_console}
GOOGLE_WEBAPP_URL_SPACE_INVADER={google_webhook_from_cloud_console}
GOOGLE_WEBAPP_URL_GALLERY={google_webhook_from_cloud_console}
GOOGLE_WEBHOOK_SECRET={google_webhook_from_cloud_console}
